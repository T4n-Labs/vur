case "$ACTION" in
post)
	# Hanya jalankan saat instalasi baru, bukan saat update
	if [ "$UPDATE" != "yes" ]; then
		# Pastikan user postgres ada (seharusnya dibuat oleh paket postgresql)
		if id postgres >/dev/null 2>&1; then
			# Fallback: Buat service runit jika paket postgresql tidak menyediakannya
			if [ ! -d /etc/sv/postgresql ]; then
				mkdir -p /etc/sv/postgresql
				cat > /etc/sv/postgresql/run << 'EOF'
#!/bin/sh
exec 2>&1
exec chpst -u postgres /usr/bin/postgres -D /var/lib/postgresql/data
EOF
				chmod 755 /etc/sv/postgresql/run
			fi

			# Inisialisasi database cluster jika belum ada
			if [ ! -f /var/lib/postgresql/data/PG_VERSION ]; then
				mkdir -p /var/lib/postgresql/data
				chown -R postgres:postgres /var/lib/postgresql
				su -s /bin/sh postgres -c "initdb -D /var/lib/postgresql/data"
			fi

			# Aktifkan service di runit
			if [ ! -L /var/service/postgresql ]; then
				ln -s /etc/sv/postgresql /var/service/
			fi
			
			# Pastikan service berjalan
			sv up postgresql >/dev/null 2>&1 || true
			sleep 2
		else
			echo "WARNING: User 'postgres' tidak ditemukan."
			echo "Pastikan paket 'postgresql' terinstall dengan benar sebelum menjalankan msfdb init."
		fi
	fi
	;;
esac